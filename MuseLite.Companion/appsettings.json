{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The companion reads the SAME MuseLite:* namespace as the agent server — in the cloud from the shared
  // Azure App Configuration store (keyless via its managed identity), locally from this fallback. Only the
  // durable-storage keys matter here (no model/email config: the companion never chats or sends).
  // This file is NOT shipped in a hosted image (CopyToPublishDirectory=Never).
  "MuseLite": {
    "DurableContext": {
      "Blob": {
        // Environment-invariant: the same real account is the keyless target locally and in the cloud.
        "AccountUri": "see dev version of app settings file",
        "ContextContainer": "assistant-context",
        "WorkingContainer": "assistant-working",
        "PolicyContainer": "assistant-policy"
      }
    }
  },

  // Local-only, ENVIRONMENT-DIFFERING keys — deliberately NOT under MuseLite:* / Azure App Configuration
  // (same split as the agent server).
  //   Backend: "File" locally, "Blob" when deployed (and the companion's real shared mode — see below).
  //   Blob:ConnectionString: the local Azurite connection string (gitignored dev settings); blank = keyless.
  //   File:BaseDirectory: File mode roots at THIS app's own bin folder, which is NOT where the agent server
  //     writes its context/ — so File mode only shares state when this points at the server's base
  //     directory (a machine-specific path: set it in the gitignored dev settings). Blob mode needs no such
  //     override and is how the companion actually shares state with the server.
  "DurableContext": {
    "Backend": "File",
    //"Backend": "Blob",
    "Blob": {
      "ConnectionString": ""
    },
    "File": {
      "BaseDirectory": ""
    }
  }
}
