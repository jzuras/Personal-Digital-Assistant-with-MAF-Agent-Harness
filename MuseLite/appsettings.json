{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // App-specific config under the MuseLite:* namespace. In the cloud these come from Azure App
  // Configuration (shared store, read keyless by the hosted agent's managed identity); this committed
  // copy is the LOCAL fallback and documents the shape. Azure App Configuration OVERRIDES these when connected.
  // This file is NOT shipped in the hosted container (CopyToPublishDirectory=Never), so the hosted agent
  // relies on Azure App Configuration for everything here, plus azure.yaml env vars for the bootstrap /
  // environment-differing (or required) values (App Config endpoint, DurableContext:Backend).
  // Secrets are NEVER committed and live only in Azure App Configuration:
  //   MuseLite:OPENROUTER_API_KEY, MuseLite:Email:ClientSecret.
  // Local-only Email/Foundry-endpoint values live in the gitignored dev settings file.
  "MuseLite": {
    // Model provider selector. false = Azure/Foundry model (MuseLite:FOUNDRY_MODEL); true = OpenRouter.
    "UseOpenRouter": false,
    "FOUNDRY_MODEL": "gpt-5.4",
    "Cors": {
      "AllowedOrigins": [
        "https://localhost:7064",
        "http://localhost:5152"
      ]
    },
    "Email": {
      "TenantId": "see dev version of app settings file",
      "ClientId": "see dev version of app settings file",
      "ClientSecret": "see dev version of app settings file",
      "SenderAddress": "see dev version of app settings file"
    },
    "DurableContext": {
      "Blob": {
        // Environment-invariant: the same real account is the keyless target locally and in the cloud.
        "AccountUri": "see dev version of app settings file",
        "ContextContainer": "assistant-context",
        "WorkingContainer": "assistant-working",
        "PolicyContainer": "assistant-policy"
      }
    }
  },

  // Local-only, ENVIRONMENT-DIFFERING keys — deliberately NOT under MuseLite:* / Azure App Configuration,
  // because the shared store would otherwise force one environment's value onto the other.
  //   Backend: "File" locally, "Blob" in the hosted container (set there via azure.yaml env var).
  //   Blob:ConnectionString: the local Azurite connection string (gitignored dev settings); blank = keyless.
  "DurableContext": {
    "Backend": "File", // Must match setting in Companion App's appsettings file
    //"Backend": "Blob", // Must match setting in Companion App's appsettings file
    "Blob": {
      "ConnectionString": "" // Must match setting in Companion App's appsettings file
    }
  }
}
