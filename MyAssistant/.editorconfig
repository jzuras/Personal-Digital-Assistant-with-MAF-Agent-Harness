# Analyzer overrides for MyAssistant (console app).
# Seeded from the nuget-audit reference baseline (the canonical triaged suppression set). root = false so
# it inherits any ancestor .editorconfig higher in the directory tree on dev machines; build-critical rules are
# duplicated here so the public-repo build is self-contained.
#
# This is an APP (console host), so app-oriented suppressions apply: CA2007 (no deadlock-prone sync
# context) and CS1591 (public XML docs not required for an app entry point).
root = false

[*.cs]
# Remove unnecessary using directives (needs GenerateDocumentationFile=true, set in the .csproj).
dotnet_diagnostic.IDE0005.severity = error

# Duplicate-using detection — belt-and-suspenders alongside IDE0005.
dotnet_diagnostic.CS8933.severity = error

# S1125: "Remove unnecessary boolean literal" contradicts the `is true`/`is false` pattern style the
# global config enforces; the cases it would legitimately catch are already build errors via IDE0019.
dotnet_diagnostic.S1125.severity = none

# CA2007: ConfigureAwait(false) not required in a console app (no deadlock-prone synchronization context).
dotnet_diagnostic.CA2007.severity = none

# CS1591: public members of an application entry point do not require XML doc comments
# (GenerateDocumentationFile is on only to activate IDE0005 at build time).
dotnet_diagnostic.CS1591.severity = none

# S125: this interactive dev console intentionally keeps a commented-out model-selection workbench
# (OpenRouter model alternatives + dated notes) for quick experimentation; it is not dead code to delete.
dotnet_diagnostic.S125.severity = none

# S1135: false-positives on the word "todo" in explanatory prose (e.g. comments describing the
# TodoProvider's "### Current todo list" injection), not actual TODO work markers.
dotnet_diagnostic.S1135.severity = none

# Project-level glob: obj/ is directly under this .editorconfig, so NO leading **/. Mark SDK-generated
# files (AssemblyInfo, GlobalUsings, etc.) as generated so analyzers skip them, and silence the CS8933
# their `using System;` trips against the implicit global using.
[obj/**/*.cs]
generated_code = true
dotnet_diagnostic.CS8933.severity = none
