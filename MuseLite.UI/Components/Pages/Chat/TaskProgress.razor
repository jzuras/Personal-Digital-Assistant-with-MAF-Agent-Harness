@{
    var completedCount = Steps.Count(s => s.Status == StepStatus.Completed);
    var progressPercent = Steps.Count > 0 ? (completedCount * 100.0 / Steps.Count) : 0;
    var firstPendingIndex = Steps.FindIndex(s => s.Status == StepStatus.Pending);
}

<div class="task-progress-card">

    <div class="decor-top-right" aria-hidden="true"></div>
    <div class="decor-bottom-left" aria-hidden="true"></div>

    <div class="card-header">
        <h3 class="card-title">Task Progress</h3>
        <span class="card-count">@completedCount/@Steps.Count Complete</span>
    </div>

    <div class="progress-track">
        <div class="progress-fill" style="width: @(progressPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
        <div class="progress-shimmer" aria-hidden="true"></div>
    </div>

    <div class="steps-list">
        @for (var i = 0; i < Steps.Count; i++)
        {
            var step = Steps[i];
            var isCompleted = step.Status == StepStatus.Completed;
            var isCurrent = !isCompleted && i == firstPendingIndex;
            var isFuture = !isCompleted && !isCurrent;
            var isLast = i == Steps.Count - 1;

            <div class="step-item @(isCompleted ? "step-completed" : isCurrent ? "step-current" : "step-future")">

                @if (!isLast)
                {
                    <div class="step-connector" aria-hidden="true"></div>
                }

                <div class="step-icon @(isCompleted ? "icon-completed" : isCurrent ? "icon-current" : "icon-future")"
                     aria-label="@(isCompleted ? "Completed" : isCurrent ? "In progress" : "Pending")">
                    @if (isCompleted)
                    {
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                        </svg>
                    }
                    else if (isCurrent)
                    {
                        <svg class="spinner-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                            <circle class="spinner-track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="spinner-fill" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                        </svg>
                    }
                    else
                    {
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" stroke-width="2" />
                            <polyline points="12,6 12,12 16,14" stroke-width="2" />
                        </svg>
                    }
                </div>

                <div class="step-text">
                    <div class="step-description @(isCompleted ? "desc-completed" : isCurrent ? "desc-current" : "desc-future")">
                        @step.Description
                    </div>
                    @if (isCurrent)
                    {
                        <div class="step-processing">Processing...</div>
                    }
                </div>

                @if (isCurrent)
                {
                    <div class="step-active-bg" aria-hidden="true"></div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Gets or sets the list of task steps to display.</summary>
    [Parameter, EditorRequired]
    public required List<TaskStep> Steps { get; set; }
}
