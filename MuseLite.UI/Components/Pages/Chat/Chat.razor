@page "/"
@rendermode InteractiveServer

<PageTitle>Muse Lite</PageTitle>

<header class="chat-header main-background-gradient">
    <div class="chat-header-content page-width">
        <div class="app-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
        </div>
        <div class="header-text">
            <span class="header-title">Muse Lite</span>
            <span class="header-hint">Ask the agent to plan or execute a multi-step task</span>
        </div>
        <div class="header-actions">
            <button class="new-conversation" @onclick="ShowResetConfirm" disabled="@ConnectionPending">New conversation</button>
        </div>
    </div>
</header>

@if (ConnectionPending)
{
    <div class="connection-panel @ConnectionCssClass">
        <div class="connection-detail">
            <span class="connection-title">
                @(Connection == ConnectionStatus.Connecting ? "Connecting to the assistant…" : "The assistant is offline")
            </span>
            <span class="connection-text">
                @(Connection == ConnectionStatus.Connecting
                    ? "Reaching the agent server."
                    : "Can’t reach the agent server — make sure it’s running. This will reconnect automatically.")
            </span>
        </div>
        @if (Connection == ConnectionStatus.Offline)
        {
            <div class="connection-actions">
                <button class="connection-retry" @onclick="RetryNowAsync">Retry now</button>
            </div>
        }
    </div>
}

@if (ResetConfirmVisible)
{
    <div class="reset-panel">
        <div class="reset-detail">
            <span class="reset-title">Start a new conversation?</span>
            <span class="reset-text">
                This clears the <strong>current conversation</strong> and starts fresh. What the agent
                knows about you is <strong>kept</strong>: your memory files (identity, preferences, memories,
                watchlist) and your standing approvals are untouched. If you want to double-check first, you
                can open those files before resetting — nothing in them is lost.
            </span>
        </div>
        <div class="reset-actions">
            <button class="reset-confirm" @onclick="NewConversationAsync">Start new</button>
            <button class="reset-cancel" @onclick="CancelResetConfirm">Cancel</button>
        </div>
    </div>
}

<ChatMessageList Messages="@Messages" InProgressMessage="@CurrentResponseMessage" Steps="@AgentState?.Steps">
    <NoMessagesContent>
        @if (ShowSuggestions)
        {
            <div class="suggestions">
                <p>Try asking the agent to build a plan, for example:</p>
                <div class="suggestion-chips">
                    <button class="suggestion-chip" @onclick='() => SendSuggestionAsync("Please build a plan to go to mars in 5 steps.")' disabled="@(Connection != ConnectionStatus.Online)">Plan a trip to Mars</button>
                    <button class="suggestion-chip" @onclick='() => SendSuggestionAsync("Please build a plan to make pizza in 4 steps.")' disabled="@(Connection != ConnectionStatus.Online)">Make a pizza</button>
                    <button class="suggestion-chip" @onclick='() => SendSuggestionAsync("Please build a plan to learn guitar in 3 steps.")' disabled="@(Connection != ConnectionStatus.Online)">Learn guitar</button>
                </div>
            </div>
        }
    </NoMessagesContent>
</ChatMessageList>

@if (PendingApproval is not null)
{
    <div class="approval-panel">
        <div class="approval-detail">
            <span class="approval-text">
                The agent wants to run <strong>@PendingApprovalToolName</strong>. Allow it?
            </span>
            @if (PendingApprovalArgs.Count > 0)
            {
                <ul class="approval-args">
                    @foreach (var arg in PendingApprovalArgs)
                    {
                        <li><span class="approval-arg-key">@arg.Key</span><span class="approval-arg-value">@arg.Value</span></li>
                    }
                </ul>
            }
        </div>
        @if (ApprovalRememberConfirmVisible)
        {
            <div class="approval-remember">
                <span class="approval-remember-text">
                    Remember permanently? <strong>@PendingApprovalToolName</strong> with these exact arguments
                    will be auto-approved in future conversations, with no prompt. You can revoke it anytime
                    by editing <code>approval-rules.json</code> in the <code>working/</code> folder.
                </span>
                <div class="approval-actions">
                    <button class="approval-approve" @onclick="AlwaysApproveAsync">Yes, remember</button>
                    <button class="approval-once" @onclick="() => RespondToApprovalAsync(true)">No, just once</button>
                </div>
            </div>
        }
        else
        {
            <div class="approval-actions">
                <button class="approval-approve" @onclick="() => RespondToApprovalAsync(true)">Approve once</button>
                <button class="approval-always" @onclick="ShowRememberConfirm">Always approve</button>
                <button class="approval-deny" @onclick="() => RespondToApprovalAsync(false)">Deny</button>
            </div>
        }
    </div>
}

<div class="chat-container">
    <ChatInput OnSend="@AddUserMessageAsync" @ref="@ChatInput" Disabled="@ConnectionPending" />
</div>
